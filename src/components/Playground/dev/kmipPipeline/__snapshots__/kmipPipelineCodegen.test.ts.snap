    print('###STEP encap error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── decap · ML-KEM-768 · decapsulate ──
try:
    r_decap = None
    r_decap = c.submit('Decapsulate',
        leaf('UniqueIdentifier', 'Identifier', priv_create),
        leaf('Data', 'ByteString', ct_encap))
    uid_decap = r_decap.get('UniqueIdentifier')
    if not r_decap.ok: raise RuntimeError(r_decap.message or 'Decapsulate failed')
    print(f'  secret={uid_decap}')
    print('###STEP decap detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_decap.payload if r_decap else None)}))
    print('###STEP decap ok###')
except Exception as _e:
    print('###STEP decap detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_decap.payload if r_decap else None)}))
    print('###STEP decap error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;

exports[`emitKmipPipeline — template snapshots > emits stable code for "Policy dry-run compare" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.

c.submit(operation, *payload) sends a real KMIP 3.0 request: \`operation\` is a
real Operation name (KMIP 3.0 Sec.4), payload is built from leaf(tag, type,
value)/struct(tag, *children) — real Attribute tag names and field types
(Sec.3 / Sec.9.1.1), the same request-building blocks the real pqctoday_kmip
client uses internally. Dispatched through the same decode -> policy ->
engine -> encode path a real server request takes.
"""
import os
import json
import traceback
from pqctoday_kmip import KmipClient, leaf, struct, find_all

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── load-permissive · Load policy: training-permissive.yaml ──
try:
    from pyodide.http import pyfetch
    _resp = await pyfetch('/kmip-policies/training-permissive.yaml')
    _yaml = await _resp.string()
    r_load_permissive = c.load_policy(_yaml)
    if not r_load_permissive.ok: raise RuntimeError(r_load_permissive.message or 'LoadPolicy failed')
    print('  policy loaded: training-permissive.yaml')
    print('###STEP load-permissive detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP load-permissive ok###')
except Exception as _e:
    print('###STEP load-permissive detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP load-permissive error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── dry-permissive · Dry-run: CreateKeyPair ──
try:
    r_dry_permissive = c.dry_run('CreateKeyPair', algorithm='ML_DSA_65')
    print(f'  dry-run: {r_dry_permissive.get("Kind")} ({r_dry_permissive.get("Reason")})')
    print('###STEP dry-permissive detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP dry-permissive ok###')
except Exception as _e:
    print('###STEP dry-permissive detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP dry-permissive error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── load-cnsa · Load policy: cnsa-2.0.yaml ──
try:
    from pyodide.http import pyfetch
    _resp = await pyfetch('/kmip-policies/cnsa-2.0.yaml')
    _yaml = await _resp.string()
    r_load_cnsa = c.load_policy(_yaml)
    if not r_load_cnsa.ok: raise RuntimeError(r_load_cnsa.message or 'LoadPolicy failed')
    print('  policy loaded: cnsa-2.0.yaml')
    print('###STEP load-cnsa detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP load-cnsa ok###')
except Exception as _e:
    print('###STEP load-cnsa detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP load-cnsa error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── dry-cnsa · Dry-run: CreateKeyPair ──
try:
    r_dry_cnsa = c.dry_run('CreateKeyPair', algorithm='ML_DSA_65')
    print(f'  dry-run: {r_dry_cnsa.get("Kind")} ({r_dry_cnsa.get("Reason")})')
    print('###STEP dry-cnsa detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP dry-cnsa ok###')
except Exception as _e:
    print('###STEP dry-cnsa detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP dry-cnsa error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;
