exports[`emitKmipPipeline — template snapshots > emits stable code for "Governed lifecycle" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.

c.submit(operation, *payload) sends a real KMIP 3.0 request: \`operation\` is a
real Operation name (KMIP 3.0 Sec.4), payload is built from leaf(tag, type,
value)/struct(tag, *children) — real Attribute tag names and field types
(Sec.3 / Sec.9.1.1), the same request-building blocks the real pqctoday_kmip
client uses internally. Dispatched through the same decode -> policy ->
engine -> encode path a real server request takes.
"""
import os
import json
import traceback
from pqctoday_kmip import KmipClient, leaf, struct, find_all

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── create · ML-DSA-65 · createKeyPair ──
try:
    r_create = None
    r_create = c.submit('CreateKeyPair',
        struct('CommonAttributes',
            leaf('CryptographicAlgorithm', 'Enumeration', 'ML_DSA_65'),
            leaf('CryptographicUsageMask', 'Integer', 'Sign Verify Encapsulate Decapsulate')))
    priv_create = r_create.get('PrivateKeyUniqueIdentifier')
    pub_create = r_create.get('PublicKeyUniqueIdentifier')
    if not r_create.ok: raise RuntimeError(r_create.message or 'CreateKeyPair failed')
    print(f'  priv={priv_create}  pub={pub_create}')
    print('###STEP create detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_create.payload if r_create else None)}))
    print('###STEP create ok###')
except Exception as _e:
    print('###STEP create detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_create.payload if r_create else None)}))
    print('###STEP create error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── sign-early · ML-DSA-65 · sign ──
try:
    r_sign_early = None
    r_sign_early = c.submit('Sign',
        leaf('UniqueIdentifier', 'Identifier', priv_create),
        struct('CryptographicParameters',
            leaf('CryptographicAlgorithm', 'Enumeration', 'ML_DSA_65')),
        leaf('Data', 'ByteString', b'test payload'.hex()))
    print(f'  signature {len(r_sign_early.get("SignatureData") or "") // 2} bytes')
    print('###STEP sign-early detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_sign_early.payload if r_sign_early else None)}))
    print('###STEP sign-early ok###')
except Exception as _e:
    print('###STEP sign-early detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_sign_early.payload if r_sign_early else None)}))
    print('###STEP sign-early error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── deny-early · Expect deny: sign-early ──
try:
    _denied = not r_sign_early.ok
    _reason = r_sign_early.get('ResultReason') or r_sign_early.get('ResultMessage') or 'denied'
    print(f'  expect-deny: {"refused (" + str(_reason) + ")" if _denied else "UNEXPECTEDLY ALLOWED — governance hole"}')
    if not _denied: raise RuntimeError('governance hole: operation was allowed when it should have been denied')
    print('###STEP deny-early detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP deny-early ok###')
except Exception as _e:
    print('###STEP deny-early detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP deny-early error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── activate · ML-DSA-65 · activate ──
try:
    r_activate = None
    r_activate = c.submit('Activate', leaf('UniqueIdentifier', 'Identifier', priv_create))
    if not r_activate.ok: raise RuntimeError(r_activate.message or 'Activate failed')
    print(f'  activated {priv_create}')
    print('###STEP activate detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_activate.payload if r_activate else None)}))
    print('###STEP activate ok###')
except Exception as _e:
    print('###STEP activate detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_activate.payload if r_activate else None)}))
    print('###STEP activate error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── sign · ML-DSA-65 · sign ──
try:
    r_sign = None
    r_sign = c.submit('Sign',
        leaf('UniqueIdentifier', 'Identifier', priv_create),
        struct('CryptographicParameters',
            leaf('CryptographicAlgorithm', 'Enumeration', 'ML_DSA_65')),
        leaf('Data', 'ByteString', b'test payload'.hex()))
    print(f'  signature {len(r_sign.get("SignatureData") or "") // 2} bytes')
    if not r_sign.ok: raise RuntimeError(r_sign.message or 'Sign failed')
    print('###STEP sign detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_sign.payload if r_sign else None)}))
    print('###STEP sign ok###')
except Exception as _e:
    print('###STEP sign detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_sign.payload if r_sign else None)}))
    print('###STEP sign error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── attrs · ML-DSA-65 · getAttributes ──
try:
    r_attrs = None
    r_attrs = c.submit('GetAttributes', leaf('UniqueIdentifier', 'Identifier', priv_create))
    if not r_attrs.ok: raise RuntimeError(r_attrs.message or 'GetAttributes failed')
    print(f'  alg={r_attrs.get("CryptographicAlgorithm")} state={r_attrs.get("State")} usage={r_attrs.get("CryptographicUsageMask")}')
    print('###STEP attrs detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_attrs.payload if r_attrs else None)}))
    print('###STEP attrs ok###')
except Exception as _e:
    print('###STEP attrs detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_attrs.payload if r_attrs else None)}))
    print('###STEP attrs error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── locate · ML-DSA-65 · locate ──
try:
    r_locate = None
    r_locate = c.submit('Locate')
    if not r_locate.ok: raise RuntimeError(r_locate.message or 'Locate failed')
    print(f'  found {len(find_all(r_locate.payload, "UniqueIdentifier"))} object(s)')
    print('###STEP locate detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_locate.payload if r_locate else None)}))
    print('###STEP locate ok###')
except Exception as _e:
    print('###STEP locate detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_locate.payload if r_locate else None)}))
    print('###STEP locate error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── revoke · ML-DSA-65 · revoke ──
try:
    r_revoke = None
    r_revoke = c.submit('Revoke',
        leaf('UniqueIdentifier', 'Identifier', priv_create),
        struct('RevocationReason', leaf('RevocationReasonCode', 'Enumeration', 'Unspecified')))
    if not r_revoke.ok: raise RuntimeError(r_revoke.message or 'Revoke failed')
    print(f'  revoked {priv_create}')
    print('###STEP revoke detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_revoke.payload if r_revoke else None)}))
    print('###STEP revoke ok###')
except Exception as _e:
    print('###STEP revoke detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_revoke.payload if r_revoke else None)}))
    print('###STEP revoke error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── destroy · ML-DSA-65 · destroy ──
try:
    r_destroy = None
    r_destroy = c.submit('Destroy', leaf('UniqueIdentifier', 'Identifier', priv_create))
    if not r_destroy.ok: raise RuntimeError(r_destroy.message or 'Destroy failed')
    print(f'  destroyed {priv_create}')
    print('###STEP destroy detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_destroy.payload if r_destroy else None)}))
    print('###STEP destroy ok###')
except Exception as _e:
    print('###STEP destroy detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_destroy.payload if r_destroy else None)}))
    print('###STEP destroy error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;

