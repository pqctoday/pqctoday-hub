exports[`emitKmipPipeline — template snapshots > emits stable code for "ACVP ML-KEM-768 known-answer test" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.

c.submit(operation, *payload) sends a real KMIP 3.0 request: \`operation\` is a
real Operation name (KMIP 3.0 Sec.4), payload is built from leaf(tag, type,
value)/struct(tag, *children) — real Attribute tag names and field types
(Sec.3 / Sec.9.1.1), the same request-building blocks the real pqctoday_kmip
client uses internally. Dispatched through the same decode -> policy ->
engine -> encode path a real server request takes.
"""
import os
import json
import traceback
from pqctoday_kmip import KmipClient, leaf, struct, find_all

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── reg-sk · Register: PrivateKey (ML_KEM_768) ──
try:
    r_reg_sk = None
    r_reg_sk = c.submit('Register',
        leaf('ObjectType', 'Enumeration', 'PrivateKey'),
        struct('Attributes',
            leaf('CryptographicAlgorithm', 'Enumeration', 'ML_KEM_768')),
        struct('PrivateKey',
            struct('KeyBlock',
                leaf('KeyFormatType', 'Enumeration', 'Raw'),
                struct('KeyValue', leaf('KeyMaterial', 'ByteString', '')),
                leaf('CryptographicAlgorithm', 'Enumeration', 'ML_KEM_768'),
                leaf('CryptographicLength', 'Integer', 19200))))
    if not r_reg_sk.ok: raise RuntimeError(r_reg_sk.message or 'Register failed')
    priv_reg_sk = r_reg_sk.get('UniqueIdentifier')
    print(f'  registered {priv_reg_sk} ({19200}-bit PrivateKey)')
    print('###STEP reg-sk detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_reg_sk.payload if r_reg_sk else None)}))
    print('###STEP reg-sk ok###')
except Exception as _e:
    print('###STEP reg-sk detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_reg_sk.payload if r_reg_sk else None)}))
    print('###STEP reg-sk error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── activate-sk · ML-KEM-768 · activate ──
try:
    r_activate_sk = None
    r_activate_sk = c.submit('Activate', leaf('UniqueIdentifier', 'Identifier', priv_reg_sk))
    if not r_activate_sk.ok: raise RuntimeError(r_activate_sk.message or 'Activate failed')
    print(f'  activated {priv_reg_sk}')
    print('###STEP activate-sk detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_activate_sk.payload if r_activate_sk else None)}))
    print('###STEP activate-sk ok###')
except Exception as _e:
    print('###STEP activate-sk detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_activate_sk.payload if r_activate_sk else None)}))
    print('###STEP activate-sk error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── decap · ML-KEM-768 · decapsulate ──
try:
    r_decap = None
    r_decap = c.submit('Decapsulate',
        leaf('UniqueIdentifier', 'Identifier', priv_reg_sk),
        leaf('Data', 'ByteString', ''))
    uid_decap = r_decap.get('UniqueIdentifier')
    if not r_decap.ok: raise RuntimeError(r_decap.message or 'Decapsulate failed')
    print(f'  secret={uid_decap}')
    print('###STEP decap detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_decap.payload if r_decap else None)}))
    print('###STEP decap ok###')
except Exception as _e:
    print('###STEP decap detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_decap.payload if r_decap else None)}))
    print('###STEP decap error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── get-ss · ML-KEM-768 · get ──
try:
    r_get_ss = None
    r_get_ss = c.submit('Get', leaf('UniqueIdentifier', 'Identifier', uid_decap))
    if not r_get_ss.ok: raise RuntimeError(r_get_ss.message or 'Get failed')
    print(f'  key material {len(r_get_ss.get("KeyMaterial") or "") // 2} bytes')
    print('###STEP get-ss detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': (r_get_ss.payload if r_get_ss else None)}))
    print('###STEP get-ss ok###')
except Exception as _e:
    print('###STEP get-ss detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': (r_get_ss.payload if r_get_ss else None)}))
    print('###STEP get-ss error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── check-ss · Assert: shared secret matches NIST ACVP ML-KEM-768 tcId=26 ──
try:
    _actual = (r_get_ss.get('KeyMaterial') or '').lower()
    _expected = '79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed'
    if _actual != _expected: raise RuntimeError(f'ACVP KAT MISMATCH — expected {_expected[:32]}..., got {_actual[:32]}...')
    print('  ACVP KAT MATCH: shared secret matches NIST ACVP ML-KEM-768 tcId=26')
    print('###STEP check-ss detail### ' + json.dumps({'kind': 'output', 'fields': [], 'tree': None}))
    print('###STEP check-ss ok###')
except Exception as _e:
    print('###STEP check-ss detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc(), 'tree': None}))
    print('###STEP check-ss error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;

